# Copy to .env.local for local development and fill in real values.
# In production set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_… keys while testing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Signs the payment/registration session cookie. Any random string, 32+ characters.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# GoHighLevel – live custom values (api/zrm-values.js) and registrations (api/register.js).
# The private integration token needs custom values (read) + contacts (read/write) scopes.
GHL_PIT_TOKEN=
GHL_LOCATION_ID=
