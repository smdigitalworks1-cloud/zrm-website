# Let the GHL funnel thank-you page (payment.tbtmart.com) load the Nexa fonts
<IfModule mod_headers.c>
  <FilesMatch "\.(ttf|otf|woff|woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# GHL token config and the custom values cache are server-only
<FilesMatch "^(zrm-config\.php|\.zrm-cache\.json)$">
  Require all denied
</FilesMatch>
